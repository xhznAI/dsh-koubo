{
  "name": "dsh-koubo",
  "version": "0.1.14",
  "description": "用人物图和讲稿制作口播视频，预览样式并管理成片。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xhznAI/dsh-koubo.git"
  },
  "homepage": "https://github.com/xhznAI/dsh-koubo#readme",
  "bugs": {
    "url": "https://github.com/xhznAI/dsh-koubo/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/api.js"
    },
    "./grok": {
      "types": "./lib/types/grok.d.ts",
      "default": "./lib/grok.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "locale/*.json",
    "skills/**",
    "examples/nex-host.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/readme-cover.png",
    "lib/gallery/**",
    "assets/gallery/**",
    "docs/plugin-detail.md",
    "assets/icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsdown --config tsdown.config.mjs && node scripts/build-gallery.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "package:check": "node scripts/check-package.mjs",
    "templates:test": "corepack pnpm build && node scripts/check-templates.mjs",
    "studio:preview": "node scripts/preview-studio.mjs",
    "gallery:posters": "node scripts/render-gallery.mjs",
    "readme:prepare": "node scripts/prepare-readme-cases.mjs",
    "readme:render": "node scripts/render-readme-cases.mjs",
    "readme:preview": "node scripts/preview-readme-cases.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@remotion/bundler": "4.0.408",
    "@remotion/player": "4.0.408",
    "@remotion/renderer": "4.0.408",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "d3-geo": "3.1.1",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "lucide-react": "1.48.0",
    "motion-dom": "12.43.0",
    "motion-utils": "12.39.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.408",
    "topojson-client": "3.1.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "world-atlas": "2.0.2"
  },
  "icon": "./assets/icon.svg"
}
